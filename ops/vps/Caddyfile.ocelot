# Ocelot's sites on the VPS's Caddy. Append to /etc/caddy/Caddyfile, then
# `caddy validate --config /etc/caddy/Caddyfile` and `systemctl reload caddy` (docs/setup.md, "5. Caddy").
#
# - db.joinocelot.com: only Supabase's public APIs (/auth/v1, /rest/v1, /storage/v1) are open to the internet.
#   Studio and every other Kong route answer only from OCELOT_ADMIN_IPS (default: nobody; use an SSH tunnel).
# - Every site drops the client-IP headers a visitor can send and sets X-Real-IP from the connection. The job report
#   rate limit (src/app/(site)/jobs/[slug]/report.ts) reads X-Real-IP.
#
# Addresses come from the environment Caddy runs with (systemctl edit caddy -> [Service] Environment=...), or the
# defaults after ":-". They match ops/vps/sb-ocelot.override.yml and compose.yaml.
#   OCELOT_KONG       Ocelot's Supabase Kong   default 127.0.0.1:8400
#   OCELOT_WEB        the Ocelot web app        default 127.0.0.1:3400
#   OCELOT_ADMIN_IPS  your own addresses        default 127.0.0.1/32

(ocelot_edge) {
	request_header -X-Forwarded-For
	request_header -X-Real-IP
	request_header -Forwarded
	request_header -Fly-Client-IP
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
		-X-Powered-By
		-X-Kong-Upstream-Latency
		-X-Kong-Proxy-Latency
		-X-Kong-Request-Id
	}
}

(ocelot_upstream) {
	header_up X-Real-IP {remote_host}
	header_down -Server
	header_down -Via
	header_down -X-Powered-By
}

db.joinocelot.com {
	import ocelot_edge
	header X-Frame-Options "DENY"

	# Résumés and logos are served from here: never run them as a page on this origin.
	@storage path /storage/v1/*
	header @storage Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"

	@public path /auth/v1/* /rest/v1/* /storage/v1/*
	handle @public {
		reverse_proxy {$OCELOT_KONG:127.0.0.1:8400} {
			import ocelot_upstream
		}
	}

	# Studio and the rest of Kong: your addresses only. Kong still asks for DASHBOARD_USERNAME / DASHBOARD_PASSWORD.
	@staff remote_ip {$OCELOT_ADMIN_IPS:127.0.0.1/32}
	handle @staff {
		reverse_proxy {$OCELOT_KONG:127.0.0.1:8400} {
			import ocelot_upstream
		}
	}

	handle {
		respond 404
	}
}

joinocelot.com, www.joinocelot.com {
	import ocelot_edge
	@www host www.joinocelot.com
	redir @www https://joinocelot.com{uri} permanent
	reverse_proxy {$OCELOT_WEB:127.0.0.1:3400} {
		import ocelot_upstream
	}
}
