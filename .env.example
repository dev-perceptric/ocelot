# Copy to .env.local for local work. On Fly these are set with `fly secrets set` (see docs/setup.md).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The public address, used in emails, the sitemap and login links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email). Needed by the worker.
RESEND_API_KEY=
EMAIL_FROM="Ocelot <hello@joinocelot.com>"

# Stripe (Milestone 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
